<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. A release APK never sees this file, so it ships
  with no exported receiver and nothing that can be driven over adb.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.teamshryne.mediyo.debug.AdbControlReceiver"
            android:exported="true"
            android:label="Mediyo adb control">
            <intent-filter>
                <action android:name="com.teamshryne.mediyo.adb" />
            </intent-filter>
        </receiver>
    </application>
</manifest>